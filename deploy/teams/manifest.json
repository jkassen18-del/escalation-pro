{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "REPLACE-WITH-YOUR-AZURE-APP-ID",
  "packageName": "internal.infraticket",
  "developer": {
    "name": "Your Company",
    "websiteUrl": "https://tickets.example.internal",
    "privacyUrl": "https://tickets.example.internal/privacy",
    "termsOfUseUrl": "https://tickets.example.internal/terms"
  },
  "name": {
    "short": "Service Desk",
    "full": "Service Desk ticketing"
  },
  "description": {
    "short": "Raise and answer tickets without leaving Teams.",
    "full": "Mention the app with a department to raise a ticket on that department's own form. Ticket updates arrive in the channel, and replying in a ticket's thread adds a comment to it."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#1F2937",
  "bots": [
    {
      "botId": "REPLACE-WITH-YOUR-AZURE-APP-ID",
      "scopes": ["team", "personal", "groupChat"],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["team", "personal", "groupChat"],
          "commands": [
            {
              "title": "finance",
              "description": "Raise a ticket on the Finance form"
            },
            {
              "title": "hr",
              "description": "Raise a ticket on the HR form"
            },
            {
              "title": "it",
              "description": "Raise a ticket on the IT form"
            }
          ]
        }
      ]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["tickets.example.internal"]
}
