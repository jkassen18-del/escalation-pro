# ---------------------------------------------------------------------------
# Escalation Pro configuration
#
# Every value here is optional. With no .env file at all the app runs on an
# embedded SQLite database, which is the recommended way to start.
# ---------------------------------------------------------------------------

# Port and bind address.
PORT=3000
HOST=0.0.0.0

# Public URL of this installation. Links inside Slack, Teams, and email
# notifications are built from it. Leave blank for local use.
APP_URL=

# ---------------------------------------------------------------------------
# Database
#
# Leave DATABASE_URL unset to use the built-in SQLite file (data/escalation-pro.db).
# Set it to switch to PostgreSQL - the schema is created automatically on boot.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://escalation:escalation@localhost:5432/escalation_pro

# Force a driver instead of inferring it from DATABASE_URL. "sqlite" or "postgres".
# DB_DRIVER=

# Where the SQLite file, uploads, and exports are written.
DATA_DIR=data

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# Signs session cookies. Generate with: openssl rand -hex 32
# If unset, a secret is generated once and persisted to data/.session-secret.
# Set it explicitly when running more than one instance behind a load balancer.
SESSION_SECRET=

# Encrypts integration credentials (Slack tokens, Linear keys, SMTP passwords)
# at rest. Defaults to SESSION_SECRET. Changing it makes stored secrets
# unreadable, and they will need to be re-entered.
SECRET_KEY=

# Set to true ONLY when serving over HTTPS. On plain HTTP this breaks sign-in,
# because the browser refuses to store a secure cookie.
SESSION_COOKIE_SECURE=false

# How long a session stays valid without activity.
SESSION_MAX_AGE_HOURS=12

# Largest single attachment, in megabytes.
MAX_UPLOAD_MB=15

# ---------------------------------------------------------------------------
# First administrator (optional)
#
# There is no public sign-up. Normally you create the first admin through the
# setup screen on first launch. These variables create it automatically
# instead, which is useful for containers and CI where nobody can fill a form.
# They are ignored once any user exists.
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator
ORGANIZATION_NAME=Escalation Pro

# ---------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------

# How often to scan for tickets that have passed their SLA, in milliseconds.
SLA_CHECK_INTERVAL_MS=300000

# ---------------------------------------------------------------------------
# Integrations (Slack, Microsoft Teams, Linear, SMTP) are NOT configured here.
# Sign in as an administrator and use Settings -> Integrations, so credentials
# are stored encrypted and can be tested from the UI.
# ---------------------------------------------------------------------------
