# ---------------------------------------------------------------------------
# InfraTicket configuration
#
# Every value here is optional. With no .env file at all the app runs on an
# embedded SQLite database, which is the recommended way to start.
# ---------------------------------------------------------------------------

# Port and bind address.
PORT=3000
HOST=0.0.0.0

# Public URL of this installation. Links inside Slack, Teams, and email
# notifications are built from it. Leave blank for local use.
APP_URL=

# ---------------------------------------------------------------------------
# Database
#
# Leave DATABASE_URL unset to use the built-in SQLite file (data/escalation-pro.db).
# Set it to switch to PostgreSQL or MySQL - the engine is taken from the URL
# scheme, and the schema is created automatically on boot.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://escalation:escalation@localhost:5432/escalation_pro
#
# MySQL 8.0.13+ or MariaDB 10.2+. Create the database as utf8mb4, or accented
# characters and emoji in ticket text will not survive:
#   CREATE DATABASE infraticket CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# DATABASE_URL=mysql://infraticket:infraticket@127.0.0.1:3306/infraticket
#
# TLS is derived from sslmode in the URL (or PGSSLMODE). Managed providers
# terminate TLS with their own private CA, so anything other than
# `sslmode=disable` encrypts the connection without verifying the server's
# certificate. To verify it properly, point PGSSLROOTCERT at the provider's CA
# (a file path, or the PEM itself).
# PGSSLROOTCERT=

# Force a driver instead of inferring it from DATABASE_URL. "sqlite" or "postgres".
# DB_DRIVER=

# Where the SQLite file, uploads, and exports are written.
DATA_DIR=data

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# Signs session cookies. Generate with: openssl rand -hex 32
# If unset, a secret is generated once and persisted to data/.session-secret.
# Set it explicitly when running more than one instance behind a load balancer.
SESSION_SECRET=

# Encrypts integration credentials (Slack tokens, Linear keys, SMTP passwords)
# at rest. Defaults to SESSION_SECRET. Changing it makes stored secrets
# unreadable, and they will need to be re-entered.
SECRET_KEY=

# Set to true ONLY when serving over HTTPS. On plain HTTP this breaks sign-in,
# because the browser refuses to store a secure cookie.
SESSION_COOKIE_SECURE=false

# How long a session stays valid without activity.
SESSION_MAX_AGE_HOURS=12

# Largest single attachment, in megabytes.
MAX_UPLOAD_MB=15

# Where attachment bytes are kept.
#   disk      - beside the app (default; needs a persistent filesystem)
#   database  - inside Postgres, for serverless platforms with no disk
# Auto-detected when left blank. The database store caps files at 6MB.
ATTACHMENT_STORE=

# Lets a scheduler run the SLA sweep over HTTP, for deployments with no
# long-running process. Required by /api/cron/sla; generate with:
#   openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# First administrator (optional)
#
# There is no public sign-up. Normally you create the first admin through the
# setup screen on first launch. These variables create it automatically
# instead, which is useful for containers and CI where nobody can fill a form.
# They are ignored once any user exists.
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator
ORGANIZATION_NAME=Service Desk

# Gate the first-run setup screen behind a shared secret.
#
# Leave blank for local or internal use: setup stays open and the first person
# to load the page creates the admin account. SET THIS BEFORE PUTTING THE APP
# ON A PUBLIC URL - otherwise whoever finds it first claims administrator.
# Generate with: openssl rand -hex 16
SETUP_TOKEN=

# ---------------------------------------------------------------------------
# Cloudflare Tunnel (optional)
#
# Publishes the app on your Cloudflare domain without opening a firewall port.
# Create a tunnel at Cloudflare Zero Trust -> Networks -> Tunnels, point its
# public hostname at http://app:3000, and paste the token here. Then run:
#   docker compose --profile tunnel up -d
# Remember to also set SESSION_COOKIE_SECURE=true and APP_URL.
# ---------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------

# How often to scan for tickets that have passed their SLA, in milliseconds.
SLA_CHECK_INTERVAL_MS=300000

# ---------------------------------------------------------------------------
# Integrations (Slack, Microsoft Teams, Linear, SMTP) are NOT configured here.
# Sign in as an administrator and use Settings -> Integrations, so credentials
# are stored encrypted and can be tested from the UI.
# ---------------------------------------------------------------------------
