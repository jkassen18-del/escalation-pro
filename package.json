{
  "name": "escalation-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Escalation Pro - a departmental ticketing and escalation management system.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "start": "node dist/server/index.mjs",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/server/index.mjs",
    "seed": "tsx server/db/seed.ts",
    "reset": "node -e \"require('fs').rmSync('data',{recursive:true,force:true})\" && npm run seed",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "npm run typecheck",
    "test": "tsx --test --test-force-exit tests/*.test.ts",
    "build:function": "esbuild server/serverless.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/function/index.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "lucide-react": "^0.546.0",
    "multer": "^2.0.1",
    "mysql2": "^3.24.4",
    "nodemailer": "^7.0.3",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "sanitize-html": "^2.17.7",
    "tailwind-merge": "^3.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.10",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.2.0"
  }
}
